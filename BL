    local lastGrab=0
    local myGrabRoot=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    Player.CharacterAdded:Connect(function(c2) myGrabRoot=c2:WaitForChild("HumanoidRootPart") end)

    local GRAB_ANIM_ID="3738476938"
    local function isGrabAnim(id) return id==GRAB_ANIM_ID or id==("rbxassetid://"..GRAB_ANIM_ID) end
    local function isNear(root2)
        if not myGrabRoot or not root2 then return false end
        local d=myGrabRoot.Position-root2.Position
        return (d.X*d.X+d.Y*d.Y+d.Z*d.Z)<=(CombatSettings.DetectRange*CombatSettings.DetectRange)
    end
    local function fireGrab()
        VIM:SendKeyEvent(true,CombatSettings.GrabKey,false,game)
        VIM:SendKeyEvent(false,CombatSettings.GrabKey,false,game)
    end
    local function tpAndGrab(enemyRoot)
        if not myGrabRoot or not enemyRoot then return end
        local now=os.clock(); if now-lastGrab<0.01 then return end; lastGrab=now
        local cf=enemyRoot.CFrame; local lv=cf.LookVector
        local behindPos=cf.Position+lv*2.5
        myGrabRoot.CFrame=CFrame.new(behindPos,behindPos+lv)
        fireGrab()
    end
    local function schedGrab(p2)
        if grabPending[p2] then return end
        local root2=grabRoots[p2]; if not root2 then return end
        if CombatSettings.PingOffset<=0 then tpAndGrab(root2); return end
        grabPending[p2]=os.clock()+CombatSettings.PingOffset
    end
    local function hookGrabAnim(anim2,p2)
        anim2.AnimationPlayed:Connect(function(track)
            if not grabEnabled then return end
            if not isGrabAnim(track.Animation.AnimationId) then return end
            if isNear(grabRoots[p2]) then schedGrab(p2) end
        end)
    end
