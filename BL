                if grabRoots[p2] and isNear(grabRoots[p2]) then tpAndGrab(grabRoots[p2]) end
            end
        end
        for p2,anim2 in pairs(grabAnims) do
            if not grabRoots[p2] or not isNear(grabRoots[p2]) then continue end
            for _,track in ipairs(anim2:GetPlayingAnimationTracks()) do
