        if obj:IsA("TextLabel") and obj.Visible and obj.BackgroundColor3==Color3.fromRGB(255,81,0) and obj.TextTransparency<1 then
            local y=obj.AbsolutePosition.Y; if y<lowestY then lowestY=y; goalNumber=tonumber(obj.Text) end
        end
    end
    for _,obj in ipairs(surfaceGui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible and obj.TextTransparency<1 and obj.BackgroundColor3==Color3.fromRGB(27,42,53) then
            if obj.ZIndex>highestZ then highestZ=obj.ZIndex; currentNumber=obj.Text end
        end
    end
    return tonumber(currentNumber) or 0, goalNumber
end

