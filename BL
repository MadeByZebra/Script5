    local JAB_WHITELIST = {
        ["rbxassetid://4227280698"]=true,["rbxassetid://4227920968"]=true,
        ["rbxassetid://7194084202"]=true,["rbxassetid://5172770969"]=true,
        ["rbxassetid://4227082585"]=true,
    }

    local function getNextJabId()
        jabCount = jabCount + 1
        if jabComboMode == "LL" then
            return LEFT_JAB_ID
        elseif jabComboMode == "RR" then
            return RIGHT_JAB_ID
        elseif jabComboMode == "LR" then
            return (jabCount % 2 == 1) and LEFT_JAB_ID or RIGHT_JAB_ID
        elseif jabComboMode == "RL" then
            return (jabCount % 2 == 1) and RIGHT_JAB_ID or LEFT_JAB_ID
        end
        return LEFT_JAB_ID
    end

