local function makeToggleRow(card,labelText,order,defaultOn,callback,tooltipText,featureKey)
    local row,lbl,div=makeFeatureRow(card,labelText,order)
    if featureKey then
        local starBtn=Instance.new("TextButton",row); starBtn.Size=UDim2.new(0,16,0,16)
        starBtn.Position=UDim2.new(0,-2,0.5,-8); starBtn.BackgroundTransparency=1
        starBtn.Text=isFavorite(featureKey) and "★" or "☆"
        starBtn.TextColor3=isFavorite(featureKey) and C_YELLOW or C_MUTED
        starBtn.TextSize=fs(12); starBtn.Font=Enum.Font.GothamBold; starBtn.ZIndex=3
        starBtn.MouseButton1Click:Connect(function()
            toggleFavorite(featureKey)
            starBtn.Text=isFavorite(featureKey) and "★" or "☆"
            starBtn.TextColor3=isFavorite(featureKey) and C_YELLOW or C_MUTED
        end)
        lbl.Position=UDim2.new(0,20,0,0); lbl.Size=UDim2.new(1,-40,1,0)
    end
    local box=Instance.new("Frame",row); box.Size=UDim2.new(0,14,0,14)
    box.Position=UDim2.new(1,-26,0.5,-7); box.BackgroundColor3=defaultOn and C_ACCENT or C_CARD
    box.BorderSizePixel=0; makeRound(box,3); makeStroke(box,defaultOn and C_ACCENT or C_MUTED,1)
    local chk=Instance.new("TextLabel",box); chk.Size=UDim2.new(1,0,1,0)
    chk.BackgroundTransparency=1; chk.Text=defaultOn and "✓" or ""; chk.TextColor3=Color3.fromRGB(255,255,255)
    chk.TextSize=10; chk.Font=Enum.Font.GothamBold; chk.TextXAlignment=Enum.TextXAlignment.Center
    local state=defaultOn
    local hitbox=Instance.new("TextButton",row); hitbox.Size=UDim2.new(1,0,1,0)
    hitbox.BackgroundTransparency=1; hitbox.Text=""; hitbox.ZIndex=2
    if tooltipText then attachTooltip(hitbox,tooltipText) end
    hitbox.MouseButton1Click:Connect(function()
        state=not state
        TweenService:Create(box,TweenInfo.new(0.15),{BackgroundColor3=state and C_ACCENT or C_CARD}):Play()
        local s=box:FindFirstChildOfClass("UIStroke"); if s then s.Color=state and C_ACCENT or C_MUTED end
        chk.Text=state and "✓" or ""
        if callback then callback(state) end
        logAction((state and "ON" or "OFF").." — "..labelText)
    end)
    local function set(val)
        state=val
        TweenService:Create(box,TweenInfo.new(0.15),{BackgroundColor3=state and C_ACCENT or C_CARD}):Play()
        local s=box:FindFirstChildOfClass("UIStroke"); if s then s.Color=state and C_ACCENT or C_MUTED end
        chk.Text=state and "✓" or ""
    end
    return row,set
end

