        pcall(function() VIM:SendKeyEvent(true,Enum.KeyCode.BackSlash,false,game) end); task.wait(0.05)
        pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.BackSlash,false,game) end); task.wait(0.05)
    end
