            local h2=char2:WaitForChild("Humanoid",10); if not h2 then return end
            local a2=h2:WaitForChild("Animator",10); if not a2 then return end
            local r2=char2:WaitForChild("HumanoidRootPart",10)
            grabRoots[p2]=r2; grabAnims[p2]=a2; hookGrabAnim(a2,p2)
        end)
    end
    local function hookGrabPlayer(p2)
        if p2==Player or grabHooked[p2] then return end; grabHooked[p2]=true
        if p2.Character then hookGrabChar(p2.Character,p2) end
        p2.CharacterAdded:Connect(function(c2)
            grabRoots[p2]=nil; grabAnims[p2]=nil; grabPending[p2]=nil
            hookGrabChar(c2,p2)
        end)
    end
