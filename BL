    arrow.Position=UDim2.new(1,-20,0,0); arrow.BackgroundTransparency=1
    arrow.Text="▾"; arrow.TextColor3=C_MUTED; arrow.TextSize=10
    arrow.Font=Enum.Font.GothamBold; arrow.TextXAlignment=Enum.TextXAlignment.Center
    local optList=Instance.new("Frame",wrap); optList.Size=UDim2.new(1,0,0,0)
    optList.AutomaticSize=Enum.AutomaticSize.Y; optList.BackgroundColor3=C_PANEL
    optList.BorderSizePixel=0; optList.Visible=false
    makeRound(optList,6); makeStroke(optList,C_STROKE,1); makeList(optList,Enum.FillDirection.Vertical,0)
