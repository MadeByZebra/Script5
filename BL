allTabFrames["combat"]=function()

    local function normalizeId(id)
        local num=id:match("id=(%d+)") or id:match("rbxassetid://(%d+)")
        return num and ("rbxassetid://"..num) or id
    end

    -- ============================================================
    -- JAB REPLACER — fixed: single connection stored per character,
    -- properly disconnected on toggle off and on respawn.
    -- ============================================================
    local JAB_MAP={["rbxassetid://5167537710"]="rbxassetid://5167521279"}
    local JAB_WHITELIST={
        ["rbxassetid://4227280698"]=true,["rbxassetid://4227920968"]=true,
        ["rbxassetid://7194084202"]=true,["rbxassetid://5172770969"]=true,
        ["rbxassetid://4227082585"]=true,
    }

    -- Module-level state so respawn handlers can reach it
    local jabActive = false
    local jabConn   = nil  -- the single AnimationPlayed connection

    local function stopJab()
        if jabConn then jabConn:Disconnect(); jabConn=nil end
    end

    local function startJab(animator)
        stopJab()  -- always clean up first
        jabConn = animator.AnimationPlayed:Connect(function(track)
            if not jabActive then return end
            local n = normalizeId(track.Animation.AnimationId)
            if JAB_WHITELIST[n] then return end
            local rep = JAB_MAP[n]
            if rep then
                track:Stop(0)
                local a = Instance.new("Animation"); a.AnimationId = rep
                animator:LoadAnimation(a):Play()
            end
        end)
    end

    -- ============================================================
    -- DODGE EXTENDER — DodgeDur is now 0.05–0.50 s (slider in ms)
    -- ============================================================
    local dodgeActive = false
    local dodgeConn   = nil
    local activeDodge = nil
    local RIGHT_DODGE_ID = "rbxassetid://4227280698"
    local LEFT_DODGE_ID  = "rbxassetid://4227920968"

    local function stopDodge()
        activeDodge = nil
        if dodgeConn then dodgeConn:Disconnect(); dodgeConn=nil end
    end

    local function smoothDodge(dir, animator)
        activeDodge={}; local thisDodge=activeDodge
        local char2=Player.Character; if not char2 then return end
        local root=char2:FindFirstChild("HumanoidRootPart"); if not root then return end
        local elapsed=0
        local wDir=root.CFrame:VectorToWorldSpace(dir)
        wDir=Vector3.new(wDir.X,0,wDir.Z).Unit
        local conn2; conn2=RunService.Heartbeat:Connect(function(dt)
            if activeDodge~=thisDodge then conn2:Disconnect(); return end
            local c3=Player.Character; if not c3 then conn2:Disconnect(); return end
            local r3=c3:FindFirstChild("HumanoidRootPart"); if not r3 then conn2:Disconnect(); return end
            elapsed=elapsed+dt
            -- eased step: fast at start, slows down at end
            local progress = math.clamp(elapsed/CombatSettings.DodgeDur, 0, 1)
            local ease = 1 - progress  -- linear ease-out factor
            local stepDist = (CombatSettings.DodgeDist / CombatSettings.DodgeDur) * dt * ease * 2
            r3.CFrame = r3.CFrame + (wDir * stepDist)
            if elapsed >= CombatSettings.DodgeDur then conn2:Disconnect() end
        end)
    end

    local function startDodge(animator)
        stopDodge()
        dodgeConn=animator.AnimationPlayed:Connect(function(track)
            if not dodgeActive then return end
            local id=normalizeId(track.Animation.AnimationId)
            if id==RIGHT_DODGE_ID then smoothDodge(Vector3.new(1,0,0), animator)
            elseif id==LEFT_DODGE_ID then smoothDodge(Vector3.new(-1,0,0), animator) end
        end)
    end

    -- Shared animator reference for this tab render
    local function getAnimator()
        local char = Player.Character or Player.CharacterAdded:Wait()
        local hum  = char:WaitForChild("Humanoid",10)
        if not hum then return nil end
        return hum:WaitForChild("Animator",10)
    end

    local animator = getAnimator()

    -- ------------------------------------------------
    -- JAB UI
    -- ------------------------------------------------
    makeSectionLabel(Content,"Jab Replacer",0)
    local jabCard=makeCard(Content,1)

    makeToggleRow(jabCard,"Replace Right Jab with Left",0,false,function(val)
        jabActive = val
        -- Always refresh animator reference on toggle
        local anim = getAnimator()
        if val then
            if anim then startJab(anim) end
            Notify("Jab Replacer ON","Right jab → Left jab",3,C_GREEN)
        else
            stopJab()
            Notify("Jab Replacer OFF","Restored.",2,C_MUTED)
        end
    end,"Swaps right jab animation with the left jab animation")

    -- ------------------------------------------------
    -- DODGE EXTENDER UI
    -- ------------------------------------------------
    makeSectionLabel(Content,"Dodge Extender",2)
    local dodgeCard=makeCard(Content,3)

    makeToggleRow(dodgeCard,"Enable Dodge Extender",0,false,function(val)
        dodgeActive = val
        local anim = getAnimator()
        if val then
            if anim then startDodge(anim) end
            Notify("Dodge Extender ON","Dodge distance boosted.",3,C_GREEN)
        else
            stopDodge()
            Notify("Dodge Extender OFF","Disabled.",2,C_MUTED)
        end
    end,"Extends the slide distance when you dodge left or right")

    -- Dodge Distance slider (1–30 studs)
    local distWrap=Instance.new("Frame",Content); distWrap.Size=UDim2.new(1,0,0,0)
    distWrap.AutomaticSize=Enum.AutomaticSize.Y; distWrap.BackgroundColor3=C_CARD
    distWrap.BorderSizePixel=0; distWrap.LayoutOrder=4
    makeRound(distWrap,8); makeStroke(distWrap,C_STROKE,1); makePadding(distWrap,8,8,12,12)
    makeList(distWrap,Enum.FillDirection.Vertical,6)

    do
        -- Distance
        local hdr=Instance.new("Frame",distWrap); hdr.Size=UDim2.new(1,0,0,14); hdr.BackgroundTransparency=1
        local hl=Instance.new("UIListLayout",hdr); hl.FillDirection=Enum.FillDirection.Horizontal
        local lbl=Instance.new("TextLabel",hdr); lbl.Size=UDim2.new(0.65,0,1,0)
        lbl.BackgroundTransparency=1; lbl.Text="Dodge Distance"; lbl.TextColor3=C_MUTED
        lbl.TextSize=fs(10); lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
        local valLbl=Instance.new("TextLabel",hdr); valLbl.Size=UDim2.new(0.35,0,1,0)
        valLbl.BackgroundTransparency=1; valLbl.Text=CombatSettings.DodgeDist.." studs"
        valLbl.TextColor3=C_ACCENT; valLbl.TextSize=fs(10); valLbl.Font=Enum.Font.GothamBold
        valLbl.TextXAlignment=Enum.TextXAlignment.Right
        local track=Instance.new("Frame",distWrap); track.Size=UDim2.new(1,0,0,12)
        track.BackgroundColor3=C_STROKE; track.BorderSizePixel=0; makeRound(track,6)
        local initRel=(CombatSettings.DodgeDist-1)/29
        local fill=Instance.new("Frame",track); fill.Size=UDim2.new(initRel,0,1,0)
        fill.BackgroundColor3=C_ACCENT; fill.BorderSizePixel=0; makeRound(fill,6)
        local thumb=Instance.new("Frame",track); thumb.Size=UDim2.new(0,14,0,14)
        thumb.Position=UDim2.new(initRel,-7,-0.1,0)
        thumb.BackgroundColor3=Color3.fromRGB(255,255,255); thumb.BorderSizePixel=0; makeRound(thumb,7)
        local slDrag=false
        local function updateDist(x)
            local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            local val=math.floor(1+rel*29); CombatSettings.DodgeDist=val
            fill.Size=UDim2.new(rel,0,1,0); thumb.Position=UDim2.new(rel,-7,-0.1,0)
            valLbl.Text=val.." studs"
        end
        thumb.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then slDrag=true end end)
        UIS.InputChanged:Connect(function(inp) if slDrag and inp.UserInputType==Enum.UserInputType.MouseMovement then updateDist(inp.Position.X) end end)
        UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then slDrag=false end end)
        track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then updateDist(inp.Position.X) end end)

        -- ------------------------------------------------
        -- Dodge Speed slider — range 50ms to 500ms, stored as seconds
        -- Default is 0.3s = 300ms. Displayed as ms so it makes sense.
        -- ------------------------------------------------
        local DODGE_MS_MIN, DODGE_MS_MAX = 50, 500
        local currentMs = math.floor(CombatSettings.DodgeDur * 1000)

        local hdr2=Instance.new("Frame",distWrap); hdr2.Size=UDim2.new(1,0,0,14); hdr2.BackgroundTransparency=1
        local hl2=Instance.new("UIListLayout",hdr2); hl2.FillDirection=Enum.FillDirection.Horizontal
        local lbl2=Instance.new("TextLabel",hdr2); lbl2.Size=UDim2.new(0.65,0,1,0)
        lbl2.BackgroundTransparency=1; lbl2.Text="Dodge Speed (lower=faster)"; lbl2.TextColor3=C_MUTED
        lbl2.TextSize=fs(10); lbl2.Font=Enum.Font.Gotham; lbl2.TextXAlignment=Enum.TextXAlignment.Left
        local valLbl2=Instance.new("TextLabel",hdr2); valLbl2.Size=UDim2.new(0.35,0,1,0)
        valLbl2.BackgroundTransparency=1; valLbl2.Text=currentMs.."ms"
        valLbl2.TextColor3=C_ACCENT; valLbl2.TextSize=fs(10); valLbl2.Font=Enum.Font.GothamBold
        valLbl2.TextXAlignment=Enum.TextXAlignment.Right
        local track2=Instance.new("Frame",distWrap); track2.Size=UDim2.new(1,0,0,12)
        track2.BackgroundColor3=C_STROKE; track2.BorderSizePixel=0; makeRound(track2,6)
        local initRel2=(currentMs-DODGE_MS_MIN)/(DODGE_MS_MAX-DODGE_MS_MIN)
        local fill2=Instance.new("Frame",track2); fill2.Size=UDim2.new(initRel2,0,1,0)
        fill2.BackgroundColor3=C_ACCENT; fill2.BorderSizePixel=0; makeRound(fill2,6)
        local thumb2=Instance.new("Frame",track2); thumb2.Size=UDim2.new(0,14,0,14)
        thumb2.Position=UDim2.new(initRel2,-7,-0.1,0)
        thumb2.BackgroundColor3=Color3.fromRGB(255,255,255); thumb2.BorderSizePixel=0; makeRound(thumb2,7)
        local slDrag2=false
        local function updateSpeed(x)
            local rel=math.clamp((x-track2.AbsolutePosition.X)/track2.AbsoluteSize.X,0,1)
            local ms=math.floor(DODGE_MS_MIN+rel*(DODGE_MS_MAX-DODGE_MS_MIN))
            -- snap to nearest 10ms for cleanliness
            ms=math.floor(ms/10)*10
            ms=math.max(DODGE_MS_MIN,ms)
            CombatSettings.DodgeDur = ms/1000  -- store as seconds
            local relFinal=(ms-DODGE_MS_MIN)/(DODGE_MS_MAX-DODGE_MS_MIN)
            fill2.Size=UDim2.new(relFinal,0,1,0); thumb2.Position=UDim2.new(relFinal,-7,-0.1,0)
            valLbl2.Text=ms.."ms"
        end
        thumb2.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then slDrag2=true end end)
        UIS.InputChanged:Connect(function(inp) if slDrag2 and inp.UserInputType==Enum.UserInputType.MouseMovement then updateSpeed(inp.Position.X) end end)
        UIS.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then slDrag2=false end end)
        track2.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then updateSpeed(inp.Position.X) end end)
    end

    -- ------------------------------------------------
    -- AUTO GRABBER
    -- ------------------------------------------------
    makeSectionLabel(Content,"Auto Grabber",5)
    local grabCard=makeCard(Content,6)

    local grabEnabled=false
    local grabHooked={}; local grabRoots={}; local grabAnims={}; local grabPending={}
    local lastGrab=0
    local myGrabRoot=Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    Player.CharacterAdded:Connect(function(c2) myGrabRoot=c2:WaitForChild("HumanoidRootPart") end)

    local GRAB_ANIM_ID="3738476938"
    local function isGrabAnim(id) return id==GRAB_ANIM_ID or id==("rbxassetid://"..GRAB_ANIM_ID) end
    local function isNear(root2)
        if not myGrabRoot or not root2 then return false end
        local d=myGrabRoot.Position-root2.Position
        return (d.X*d.X+d.Y*d.Y+d.Z*d.Z)<=(CombatSettings.DetectRange*CombatSettings.DetectRange)
    end
    local function fireGrab()
        VIM:SendKeyEvent(true,CombatSettings.GrabKey,false,game)
        VIM:SendKeyEvent(false,CombatSettings.GrabKey,false,game)
    end
    local function tpAndGrab(enemyRoot)
        if not myGrabRoot or not enemyRoot then return end
        local now=os.clock(); if now-lastGrab<0.01 then return end; lastGrab=now
        local cf=enemyRoot.CFrame; local lv=cf.LookVector
        local behindPos=cf.Position+lv*2.5
        myGrabRoot.CFrame=CFrame.new(behindPos,behindPos+lv)
        fireGrab()
    end
    local function schedGrab(p2)
        if grabPending[p2] then return end
        local root2=grabRoots[p2]; if not root2 then return end
        if CombatSettings.PingOffset<=0 then tpAndGrab(root2); return end
        grabPending[p2]=os.clock()+CombatSettings.PingOffset
    end
    local function hookGrabAnim(anim2,p2)
        anim2.AnimationPlayed:Connect(function(track)
            if not grabEnabled then return end
            if not isGrabAnim(track.Animation.AnimationId) then return end
            if isNear(grabRoots[p2]) then schedGrab(p2) end
        end)
    end
    local function hookGrabChar(char2,p2)
        task.spawn(function()
            local h2=char2:WaitForChild("Humanoid",10); if not h2 then return end
            local a2=h2:WaitForChild("Animator",10); if not a2 then return end
            local r2=char2:WaitForChild("HumanoidRootPart",10)
            grabRoots[p2]=r2; grabAnims[p2]=a2; hookGrabAnim(a2,p2)
        end)
    end
    local function hookGrabPlayer(p2)
        if p2==Player or grabHooked[p2] then return end; grabHooked[p2]=true
        if p2.Character then hookGrabChar(p2.Character,p2) end
        p2.CharacterAdded:Connect(function(c2)
            grabRoots[p2]=nil; grabAnims[p2]=nil; grabPending[p2]=nil
            hookGrabChar(c2,p2)
        end)
    end
    for _,p2 in ipairs(Players:GetPlayers()) do hookGrabPlayer(p2) end
    Players.PlayerAdded:Connect(hookGrabPlayer)
    Players.PlayerRemoving:Connect(function(p2)
        grabHooked[p2]=nil; grabRoots[p2]=nil; grabAnims[p2]=nil; grabPending[p2]=nil
    end)
    RunService.Heartbeat:Connect(function()
        if not grabEnabled then return end
        local now=os.clock()
        for p2,fireAt in pairs(grabPending) do
            if now>=fireAt then
                grabPending[p2]=nil
                if grabRoots[p2] and isNear(grabRoots[p2]) then tpAndGrab(grabRoots[p2]) end
            end
        end
        for p2,anim2 in pairs(grabAnims) do
            if not grabRoots[p2] or not isNear(grabRoots[p2]) then continue end
            for _,track in ipairs(anim2:GetPlayingAnimationTracks()) do
                if isGrabAnim(track.Animation.AnimationId) then schedGrab(p2); break end
            end
        end
    end)

    makeToggleRow(grabCard,"Enable Auto Grabber",0,false,function(val)
        grabEnabled=val
        if val then Notify("Auto Grabber ON","Watching nearby players.",3,C_GREEN)
        else Notify("Auto Grabber OFF","Disabled.",2,C_MUTED) end
    end,"Auto-grabs nearby enemies when they play the grab animation")

    -- Right panel
    makeRightSection("Grabber",0)
    makeRightSlider("Detect Range",5,100,CombatSettings.DetectRange," studs",1,function(val) CombatSettings.DetectRange=val end)
    makeRightSlider("Ping Offset",0,300,math.floor(CombatSettings.PingOffset*1000)," ms",2,function(val) CombatSettings.PingOffset=val/1000 end)
    makeRightSection("Grab Key",5); makeRightKeybind("Current Key",CombatSettings.GrabKey.Name,6)
    makeButtonRow(makeCard(RightScroll,7),"Set Grab Key",0,function()
        Notify("Listening...","Press your grab key.",4,C_ACCENT)
        local conn; conn=UIS.InputBegan:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.Keyboard then
                local kc=inp.KeyCode
                if kc~=Enum.KeyCode.LeftShift and kc~=Enum.KeyCode.RightShift then
                    conn:Disconnect(); CombatSettings.GrabKey=kc; Notify("Grab Key Set","["..kc.Name.."]",3,C_GREEN)
                end
            end
        end)
    end)

    -- ------------------------------------------------
    -- Respawn handler — reconnect jab/dodge to new character's Animator
    -- ------------------------------------------------
    Player.CharacterAdded:Connect(function(newChar)
        local newHum  = newChar:WaitForChild("Humanoid",10)
        local newAnim = newHum and newHum:WaitForChild("Animator",10)
        if not newAnim then return end
        animator = newAnim
        if jabActive   then startJab(newAnim)   end
        if dodgeActive then startDodge(newAnim) end
    end)
end

