local IO_CFG = {
    keysEnabled    = true,
    mouseEnabled   = true,
    spaceEnabled   = true,
    keyUpDelay     = 0.018,
    heldRefire     = 0.07,
    minGap         = 0.008,
}
local IO_PRESETS = {
    { name="Low Ping",  desc="<80ms",        keyUpDelay=0.016, heldRefire=0.065 },
    { name="Med-High",  desc="130-150ms",    keyUpDelay=0.038, heldRefire=0.095 },
    { name="High Ping", desc="200-250ms+",   keyUpDelay=0.070, heldRefire=0.150 },
}
local IO_ABILITY_KEYS = {
    [Enum.KeyCode.C]=true,[Enum.KeyCode.E]=true,[Enum.KeyCode.R]=true,
    [Enum.KeyCode.Q]=true,[Enum.KeyCode.F]=true,[Enum.KeyCode.X]=true,
    [Enum.KeyCode.T]=true,
}
local IO_MOUSE_BTNS = {
    [Enum.UserInputType.MouseButton1]=0,
    [Enum.UserInputType.MouseButton2]=1,
}
local IO_KEY_NAMES = {}
do
    local prefix = "Enum.KeyCode."
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        local full = tostring(kc)
        IO_KEY_NAMES[kc] = full:sub(#prefix + 1)
    end
    IO_KEY_NAMES[0] = "MB1"; IO_KEY_NAMES[1] = "MB2"
end
local IO_keyHeld     = {}
local IO_heldThreads = {}
local IO_lastFired   = {}
local IO_lastLabel   = "—"
local IO_sliderApplyFns = {}
local IO_activePresetIdx = nil

local function IO_getMouseXY()
    local pos = UIS:GetMouseLocation(); return pos.X, pos.Y
end
local function IO_fireKey(key)
    local now = os.clock()
    if (now - (IO_lastFired[key] or 0)) < IO_CFG.minGap then return end
    IO_lastFired[key] = now
    VIM:SendKeyEvent(true, key, false, game)
    task.delay(IO_CFG.keyUpDelay, function() VIM:SendKeyEvent(false, key, false, game) end)
end
local function IO_fireMouse(idx)
    local now = os.clock()
    if (now - (IO_lastFired[idx] or 0)) < IO_CFG.minGap then return end
    IO_lastFired[idx] = now
    local x, y = IO_getMouseXY()
    VIM:SendMouseButtonEvent(x, y, idx, true, game, 0)
    task.delay(IO_CFG.keyUpDelay, function()
        local rx, ry = IO_getMouseXY()
        VIM:SendMouseButtonEvent(rx, ry, idx, false, game, 0)
    end)
end
local function IO_startHeldRefire(key)
    if IO_heldThreads[key] then return end
    IO_heldThreads[key] = task.spawn(function()
        while IO_keyHeld[key] do
            task.wait(IO_CFG.heldRefire)
            if IO_keyHeld[key] then IO_fireKey(key) end
        end
        IO_heldThreads[key] = nil
    end)
end
local function IO_stopHeldRefire(key)
    IO_keyHeld[key] = nil
end

-- InputOptimizer always-on input connections
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local itype = input.UserInputType
    if itype == Enum.UserInputType.Keyboard then
        local key = input.KeyCode
        if key == Enum.KeyCode.Space and IO_CFG.spaceEnabled then
            IO_lastLabel = "Space"; return
        end
        if IO_CFG.keysEnabled and IO_ABILITY_KEYS[key] and not IO_keyHeld[key] then
            IO_keyHeld[key] = true
            IO_lastLabel = IO_KEY_NAMES[key] or tostring(key)
            IO_fireKey(key); IO_startHeldRefire(key)
        end
        return
    end
    local idx = IO_MOUSE_BTNS[itype]
    if idx ~= nil and IO_CFG.mouseEnabled then
        IO_lastLabel = IO_KEY_NAMES[idx]; IO_fireMouse(idx)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.Space and IO_CFG.spaceEnabled then
        VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game); return
    end
    IO_stopHeldRefire(key)
end)
Players.LocalPlayer.CharacterAdded:Connect(function()
    for k in next, IO_keyHeld do IO_stopHeldRefire(k) end
    IO_keyHeld = {}
end)
-- ── End InputOptimizer Module ──────────────────────────────────────────

