            local id=normalizeId(track.Animation.AnimationId)
            if id==RIGHT_DODGE_ID then
                smoothDodge(Vector3.new(1,0,0), animator)
            elseif id==LEFT_DODGE_ID then
                smoothDodge(Vector3.new(-1,0,0), animator)
            end
        end)
    end

