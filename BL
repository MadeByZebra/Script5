end
local autoClashThread,alreadyExited=nil,false
local function startAutoClash()
    if autoClashThread then return end; alreadyExited=false
    autoClashThread=task.spawn(function()
        while ClashSettings.AutoClash do
            local ZN=getZN()
            if ZN then
                if allButtonsDone(ZN) then
                    if not alreadyExited then alreadyExited=true; task.wait(0.3); exitUINavigation(); Notify("Clash Complete ✅","All green.",3,C_GREEN) end; task.wait(0.1)
