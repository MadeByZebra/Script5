allTabFrames["inputopt"]=function()
    -- ── Header ──
    makeSectionLabel(Content,"Ability Keys  (C E R Q F X T)",0)

    -- ── Slider helper (inline, reuses main script helpers) ──
    local function makeIOSliderRow(labelText,order,minV,maxV,initV,fmt,cfgKey)
        local card=Instance.new("Frame",Content); card.Size=UDim2.new(1,0,0,32)
        card.BackgroundColor3=C_CARD; card.BorderSizePixel=0; card.LayoutOrder=order
        makeRound(card,8); makeStroke(card,C_STROKE,1)
        local lbl=Instance.new("TextLabel",card); lbl.Size=UDim2.new(0,140,1,0)
        lbl.Position=UDim2.new(0,12,0,0); lbl.BackgroundTransparency=1
        lbl.Text=labelText..": "..fmt(initV); lbl.TextColor3=C_MUTED
        lbl.TextSize=fs(10); lbl.Font=Enum.Font.Gotham; lbl.TextXAlignment=Enum.TextXAlignment.Left
        local track=Instance.new("Frame",card); track.Size=UDim2.new(1,-168,0,6)
        track.Position=UDim2.new(0,156,0.5,-3); track.BackgroundColor3=C_STROKE
        track.BorderSizePixel=0; makeRound(track,3)
        local fill=Instance.new("Frame",track); fill.Size=UDim2.new((initV-minV)/(maxV-minV),0,1,0)
        fill.BackgroundColor3=C_ACCENT; fill.BorderSizePixel=0; makeRound(fill,3)
        local knob=Instance.new("TextButton",track); knob.Size=UDim2.new(0,14,0,14)
        knob.AnchorPoint=Vector2.new(0.5,0.5); knob.Position=UDim2.new((initV-minV)/(maxV-minV),0,0.5,0)
        knob.BackgroundColor3=Color3.fromRGB(200,220,255); knob.BorderSizePixel=0
        knob.Text=""; knob.AutoButtonColor=false; makeRound(knob,7)
        local function applyVal(val)
            local rel=math.clamp((val-minV)/(maxV-minV),0,1)
            fill.Size=UDim2.new(rel,0,1,0); knob.Position=UDim2.new(rel,0,0.5,0)
            lbl.Text=labelText..": "..fmt(val); IO_CFG[cfgKey]=val
        end
        IO_sliderApplyFns[cfgKey]=applyVal
        local dragging=false
        knob.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true end end)
        UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
        UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
                local tp=track.AbsolutePosition; local ts=track.AbsoluteSize
                local rel=math.clamp((i.Position.X-tp.X)/ts.X,0,1)
                local val=minV+rel*(maxV-minV)
                fill.Size=UDim2.new(rel,0,1,0); knob.Position=UDim2.new(rel,0,0.5,0)
                lbl.Text=labelText..": "..fmt(val); IO_CFG[cfgKey]=val
                IO_activePresetIdx=nil
            end
        end)
    end

    makeIOSliderRow("Key-up delay",1,0.005,0.080,IO_CFG.keyUpDelay,
        function(v) return math.floor(v*1000).."ms" end,"keyUpDelay")
    makeIOSliderRow("Hold re-fire", 2,0.040,0.500,IO_CFG.heldRefire,
        function(v) return math.floor(v*1000).."ms" end,"heldRefire")

    -- ── Presets ──
    makeSectionLabel(Content,"Ping Presets",3)
    local presetRow=Instance.new("Frame",Content); presetRow.Size=UDim2.new(1,0,0,36)
    presetRow.BackgroundTransparency=1; presetRow.BorderSizePixel=0; presetRow.LayoutOrder=4
    local prl=Instance.new("UIListLayout",presetRow)
    prl.FillDirection=Enum.FillDirection.Horizontal; prl.Padding=UDim.new(0,6)
    prl.VerticalAlignment=Enum.VerticalAlignment.Center

    local presetBtnRefs={}
    for i,preset in ipairs(IO_PRESETS) do
        local btn=Instance.new("TextButton",presetRow); btn.Size=UDim2.new(0,110,1,-4)
        local isAct=(IO_activePresetIdx==i)
        btn.BackgroundColor3=isAct and C_ACCENT or C_CARD; btn.BorderSizePixel=0
        btn.Text=preset.name.."\n"..preset.desc
        btn.TextSize=fs(10); btn.Font=Enum.Font.GothamBold
        btn.TextColor3=isAct and Color3.fromRGB(255,255,255) or C_MUTED
        btn.AutoButtonColor=false; makeRound(btn,7); makeStroke(btn,isAct and C_ACCENT or C_STROKE,1)
        presetBtnRefs[i]={btn=btn}
        btn.MouseButton1Click:Connect(function()
            if IO_sliderApplyFns["keyUpDelay"] then IO_sliderApplyFns["keyUpDelay"](preset.keyUpDelay) end
            if IO_sliderApplyFns["heldRefire"]  then IO_sliderApplyFns["heldRefire"](preset.heldRefire)  end
            IO_activePresetIdx=i
            for j,pb in ipairs(presetBtnRefs) do
                local active=(j==i)
                pb.btn.BackgroundColor3=active and C_ACCENT or C_CARD
                pb.btn.TextColor3=active and Color3.fromRGB(255,255,255) or C_MUTED
                local st=pb.btn:FindFirstChildOfClass("UIStroke"); if st then st.Color=active and C_ACCENT or C_STROKE end
            end
            Notify("Input Preset","Set to "..preset.name.." ("..preset.desc..")",3,C_ACCENT,"system")
        end)
    end

    -- ── Toggle switches ──
    makeSectionLabel(Content,"Toggles",5)
    local togCard=makeCard(Content,6)
    makeToggleRow(togCard,"Ability Keys  (C E R Q F X T)",0,IO_CFG.keysEnabled,function(val)
        IO_CFG.keysEnabled=val; IO_keyHeld={}
        Notify("Input Opt – Keys",val and "Ability keys ON" or "Ability keys OFF",2,val and C_GREEN or C_MUTED,"system")
    end,"Enable/disable VIM injection for ability keys")
    makeToggleRow(togCard,"Mouse  (MB1 jab / MB2 dodge)",1,IO_CFG.mouseEnabled,function(val)
        IO_CFG.mouseEnabled=val
        Notify("Input Opt – Mouse",val and "Mouse ON" or "Mouse OFF",2,val and C_GREEN or C_MUTED,"system")
    end,"Enable/disable VIM injection for mouse buttons")
    makeToggleRow(togCard,"Spacebar intercept",2,IO_CFG.spaceEnabled,function(val)
        IO_CFG.spaceEnabled=val
        Notify("Input Opt – Space",val and "Space ON" or "Space OFF",2,val and C_GREEN or C_MUTED,"system")
    end,"Intercept spacebar release for instant key-up")

    -- ── Live status (right panel) ──
    makeRightSection("Live Status",0)
    local statusCard2=Instance.new("Frame",RightScroll); statusCard2.Size=UDim2.new(1,0,0,28)
    statusCard2.BackgroundColor3=C_CARD; statusCard2.BorderSizePixel=0; statusCard2.LayoutOrder=1
    makeRound(statusCard2,6); makeStroke(statusCard2,C_STROKE,1)
    local lastLbl2=Instance.new("TextLabel",statusCard2); lastLbl2.Size=UDim2.new(1,-10,1,0)
    lastLbl2.Position=UDim2.new(0,10,0,0); lastLbl2.BackgroundTransparency=1
    lastLbl2.TextColor3=C_MUTED; lastLbl2.TextSize=fs(10); lastLbl2.Font=Enum.Font.GothamMedium
    lastLbl2.TextXAlignment=Enum.TextXAlignment.Left; lastLbl2.Text="last: —"
    RunService.Heartbeat:Connect(function()
        if lastLbl2 and lastLbl2.Parent then lastLbl2.Text="last: "..IO_lastLabel end
    end)

    makeRightSection("Settings",5)
    makeRightSlider("Min Gap",1,20,math.floor(IO_CFG.minGap*1000),"ms",6,function(val)
        IO_CFG.minGap=val/1000
    end)

    makeRightSection("Info",10)
    local infoCard2=makeCard(RightScroll,11)
    local tips2={
        "v14fix — tighter space key-up",
        "Hold re-fire keeps key held",
        "Min Gap prevents key spam drop",
        "Presets tune for your ping",
    }
    for i,tip in ipairs(tips2) do
        local _,lbl,div=makeFeatureRow(infoCard2,tip,i); lbl.TextColor3=C_MUTED
        lbl.Font=Enum.Font.Gotham; lbl.TextSize=fs(10); if i==#tips2 then div:Destroy() end
    end
end


