local function getButtonValue(btn)
    if not btn then return nil end; local MC=btn:FindFirstChild("MC"); if not MC then return nil end
    local MXVal=MC:FindFirstChild("MX"); if not MXVal then return nil end; return MXVal.Value
end
local function isButtonDone(btn) local val=getButtonValue(btn); return val==nil or val<=0 end
local function allButtonsDone(ZN)
    for i=1,4 do local btn=ZN:FindFirstChild("B"..i); if btn and not isButtonDone(btn) then return false end end; return true
end
local function getButtonCenter(mc)
    return Vector2.new(mc.AbsolutePosition.X+mc.AbsoluteSize.X/2,mc.AbsolutePosition.Y+mc.AbsoluteSize.Y/2)
end
local function clashButton(btn)
    if not btn or isButtonDone(btn) then return end; local MC=btn:FindFirstChild("MC"); if not MC then return end
    local MXVal=MC:FindFirstChild("MX"); if not MXVal or MXVal.Value<=0 then return end
    local center=getButtonCenter(MC)
